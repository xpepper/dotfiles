alias ldots='ls -a | egrep "^\.[^\.]"'

## Using eza as ls replacement
# alias ll='exa -l'
# alias l='exa -l'

## Using lsd (https://github.com/lsd-rs/lsd) as ls replacement
alias ls='lsd'
alias l='ls -l'
alias ll='ls -la'
alias lt='ls --tree'

## Elixir
alias mta='mix test.all'

alias hosts='sudo vim /etc/hosts'
alias hidden='ls -a | grep "^\."'
alias uuid="uuidgen | tr '[:upper:]' '[:lower:]' | tr -d '\n' | tee >(pbcopy)"

# GitHub CLI
alias ghv='gh pr view --web'
alias ghr='gh repo view --web'
pr-summarise() {
  gh pr-summarise "$@" --yes --force 
}

# LLMs
alias pplx="llm -m sonar"
alias pplxpro="llm -m sonar-pro"

# K8S
alias kk='kubectx'

# Maven
alias mct='mvn -T 4 clean test'
alias mw='./mvnw'

# Gradle
alias gw='./gradlew'
gww() {
  ./gradlew "$@"
  if [[ $? -eq 0 ]]; then 
    say -v Luca "ho finito"
  else
    say -v Whisper "failed?"
  fi
}

alias gradle-all-deps='./gradlew dependencies $(./gradlew -q projects \
    | grep -Fe ---\ Project \
    | sed -Ee "s/^.+--- Project '"'([^']+)'/\1:dependencies/"'")'

sound() {
  "$@"
  if [[ $? -eq 0 ]]; then 
    say -v Luca "ho finito"
  else
    say -v Whisper "failed?"
  fi
}

makesound() {
  sound make "$@"
}

yarnsound() {
  sound yarn "$@"
}

cargosound() {
  sound cargo "$@"
}

mixsound() {
  sound mix "$@"
}

konnect() {
  pod=$(kubectl get pods | grep -e "$1" | awk 'NR==1{print $1}')
  echo "connecting to $pod..."
  kubectl exec -it $pod -- bash
}

# CLI tools (https://remysharp.com/2018/08/23/cli-improved)
alias cat='bat --no-pager'
export BAT_STYLE=plain
alias ping='prettyping'
alias more='most'

# Prima
alias sp='suite-py'
alias sprc='suite-py release create -i'
alias spcb='suite-py create-branch --autostash'
alias sppr='suite-py open-pr'
